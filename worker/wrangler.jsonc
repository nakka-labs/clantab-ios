{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clantab",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // The `aud` an Apple identity token must carry — the app's bundle id.
    "APPLE_AUDIENCE": "com.clantab.app",
    // The `aud` a Google identity token must carry — the iOS OAuth client id
    // (`MANDATORY_LOGIN_PLAN.md` Part 1). Created 2026-09-05.
    "GOOGLE_AUDIENCE": "785063933196-ieaukpoat5r6v5jjr65315o9rniaaahn.apps.googleusercontent.com",
    // The R2 bucket the presigned-URL signer targets (`src/lib/media.ts`). This
    // is the production bucket; `wrangler dev` overrides it to the preview
    // bucket via `worker/.dev.vars` so local uploads never touch prod objects.
    // This and the `MEDIA` binding below must name the same bucket per
    // environment. The R2 S3-API credentials are secrets, not vars —
    // `wrangler secret put R2_ACCOUNT_ID` / `R2_ACCESS_KEY_ID` /
    // `R2_SECRET_ACCESS_KEY`; see `.dev.vars.example`.
    "R2_BUCKET": "clantab-media"
    // SESSION_SIGNING_KEY is deliberately NOT here. `wrangler deploy` applies
    // `vars` and a plain var overwrites a same-named secret, so putting it here
    // clobbers the production secret on every deploy. Instead:
    //   prod   → `wrangler secret put SESSION_SIGNING_KEY`
    //   dev    → worker/.dev.vars   (gitignored; see .dev.vars.example)
    //   tests  → vitest.workers.config.ts miniflare bindings
  },
  "durable_objects": {
    "bindings": [
      { "name": "GROUP_DO", "class_name": "GroupDO" },
      { "name": "USER_DO", "class_name": "UserDO" },
      { "name": "REPORTS_DO", "class_name": "ReportsDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GroupDO", "RegistryDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserDO"]
    },
    {
      // RegistryDO retired (SHIP_PLAN.md Track 3 §3): its one job — the
      // `joinCode -> groupId` index — moved to Workers KV (`JOIN_CODES`
      // below), which has no singleton chokepoint. No real users existed
      // yet (Phase 0, NEXT_STEPS.md), so this is a clean cutover: no
      // migration of pre-existing join codes out of the DO's SQLite storage.
      "tag": "v3",
      "deleted_classes": ["RegistryDO"]
    },
    {
      // ReportsDO: the content-report log (SHIP_PLAN.md Track 3 §7, Apple
      // Guideline 1.2). A global singleton, not per-group — see its own
      // doc comment.
      "tag": "v4",
      "new_sqlite_classes": ["ReportsDO"]
    }
  ],
  "kv_namespaces": [
    // `joinCode -> groupId`, write-once at group creation, read-many on
    // lookup (`src/lib/join-codes.ts`).
    { "binding": "JOIN_CODES", "id": "77e548b600ef46f190955c4aa5e4f6aa" }
  ],
  "r2_buckets": [
    // Image storage (`CHECKLIST.md` "Image storage backend (R2)"). One bucket,
    // objects namespaced by path (`avatars/…`, `groups/<id>/cover`,
    // `expenses/<gid>/<eid>/<id>`). The binding is only for server-side
    // deletes; uploads/views go through presigned S3 URLs (`src/lib/media.ts`).
    // `preview_bucket_name` is what `wrangler dev --remote` and the vitest
    // pool use, so prod objects are never touched by dev or tests.
    {
      "binding": "MEDIA",
      "bucket_name": "clantab-media",
      "preview_bucket_name": "clantab-media-preview"
    }
  ],
  "unsafe": {
    "bindings": [
      // Per-IP cap on GET /api/groups/resolve/:joinCode, replacing
      // RegistryDO's in-memory counter (durable across the Worker's
      // lifecycle, not reset on DO eviction). Still "unsafe"-namespaced in
      // wrangler 4.35; that's just where this binding type currently lives.
      {
        "name": "RESOLVE_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  }
}
