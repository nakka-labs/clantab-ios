<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Kept in sync with docs/appstore/metadata.md's "App Privacy" table
	  (last synced 2026-09-08 — added User ID + Device ID for mandatory
	  Apple/Google sign-in and push).

	  Data leaving the device (sent to the ClanTab Worker backend):
	    - the display name the user typed for a group ("Name")
	    - expense/settlement records + content-report free text ("Other Data Types")
	    - the opaque Apple/Google account identifier that recognises a returning
	      user, plus per-group member ids ("User ID")
	    - the APNs push token, only if the user enables notifications, used only
	      to notify them about their own groups ("Device ID")
	  Everything is "Linked", nothing is used for tracking, every purpose is
	  "App Functionality". No email/phone, no payment credentials, no analytics
	  or advertising SDKs. Sign in with Apple requests no name or email; a Google
	  sign-in token carries an email but the backend reads only the anonymous
	  subject id and never stores or logs it (declared "not collected" — see the
	  metadata.md note).

	  Judgement calls, revisit if App Review pushes back:
	    - The self-chosen display name is declared as "Name", "Linked" (it is
	      tied to a per-group member id), "not used for tracking", purpose
	      "App Functionality".
	    - Shared-expense ledger content is declared as "Other Data Types" rather
	      than "Other Financial Info" — it records group spending, not the
	      user's personal financial standing (salary/assets/debts).
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- @AppStorage + the app's own UserDefaults stores (known groups,
			     onboarding flag, cached push token, nudge timestamps): reading
			     and writing this app's own settings only. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
